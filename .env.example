# ==============================================================================
# Aurelia TimeFlow — AWS RDS PostgreSQL Environment Template (ap-south-1 Mumbai)
# ==============================================================================
# SECURITY & INFRASTRUCTURE RULES:
# 1. Never commit real credentials, instance DNS hashes, or `.env` files to Git.
# 2. Never prefix database variables with `VITE_` — database credentials must
#    remain strictly server-side.
# 3. Production RDS in AWS Mumbai (`ap-south-1`) must remain private
#    (`Publicly accessible = No`). Never open TCP 5432 to `0.0.0.0/0`.
# 4. Do NOT set `AWS_PRIVATE_VPC_EXECUTION=true` or `AWS_RDS_BACKUP_VERIFIED=true`
#    in Google AI Studio or local laptops. Set them only inside a verified AWS
#    VPC runtime after confirming the corresponding condition.
# ==============================================================================

# Application runtime environment: development | staging | production
APP_ENV=development
NODE_ENV=development

# AWS RDS PostgreSQL Configuration (Standard RDS Instance Endpoint in ap-south-1)
AWS_REGION=ap-south-1
AWS_RDS_HOST=<db-instance-identifier>.<rds-dns-id>.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432

# Database Name:
# The AWS RDS console currently provisions the default database named `postgres`.
# Keep `AWS_RDS_DATABASE=postgres` unless you first run
# `src/server/db/migrations/0000_create_database_and_role.sql` from inside the
# private VPC to create the dedicated `aurelia_timeflow` database.
AWS_RDS_DATABASE=postgres

# Least-privilege application database role (NOSUPERUSER, NOBYPASSRLS)
AWS_RDS_USER=<replace-with-least-privilege-db-user>
AWS_RDS_PASSWORD=<replace-with-secrets-manager-or-env-password>

# TLS Configuration: require | verify-ca | verify-full (never disable SSL)
AWS_RDS_SSL_MODE=verify-full
# Optional PEM-encoded Amazon RDS Root CA bundle for verify-ca / verify-full:
# AWS_RDS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Connection Pool Maximum Size (integer between 1 and 100)
AWS_RDS_POOL_MAX=10

# Optional: AWS Secrets Manager RDS JSON payload (supported on ECS Fargate / App Runner)
# AWS_RDS_SECRET_JSON={"host":"<db-instance>.<id>.ap-south-1.rds.amazonaws.com","port":5432,"dbname":"postgres","username":"<user>","password":"<secret>"}

# Private VPC & Backup Verification Gates (MUST remain false outside verified AWS VPC)
AWS_PRIVATE_VPC_EXECUTION=false
AWS_RDS_BACKUP_VERIFIED=false
