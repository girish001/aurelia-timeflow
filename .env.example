# ==============================================================================
# Aurelia TimeFlow — AWS RDS / Aurora PostgreSQL Environment Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit real credentials or `.env` files to version control.
# 2. Never prefix database variables with `VITE_` — database credentials must
#    remain strictly server-side.
# ==============================================================================

# Application runtime environment: development | staging | production
APP_ENV=development
NODE_ENV=development

# AWS RDS / Aurora PostgreSQL Configuration
AWS_REGION=ap-south-1
AWS_RDS_HOST=aurelia-timeflow-db.cluster-xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=aurelia_timeflow
AWS_RDS_USER=aurelia_app
AWS_RDS_PASSWORD=<replace-with-secret-manager-or-env-password>
AWS_RDS_SSL_MODE=require
AWS_RDS_POOL_MAX=10
