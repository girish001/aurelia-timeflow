# ==============================================================================
# Aurelia TimeFlow — AWS RDS PostgreSQL Environment Template (ap-south-1 Mumbai)
# ==============================================================================
# SECURITY & INFRASTRUCTURE RULES:
# 1. Never commit real credentials, instance DNS hashes, or `.env` files to Git.
# 2. Never prefix database variables with `VITE_` — database credentials must
#    remain strictly server-side.
# 3. Production RDS in AWS Mumbai (`ap-south-1`) must remain private
#    (`Publicly accessible = No`). Never open TCP 5432 to `0.0.0.0/0`.
# 4. Do NOT set `AWS_PRIVATE_VPC_EXECUTION=true` or `AWS_RDS_BACKUP_VERIFIED=true`
#    in Google AI Studio or local laptops. Set them only inside a verified AWS
#    VPC runtime after confirming the corresponding condition.
# ==============================================================================

# Application runtime environment: development | staging | production
APP_ENV=development
NODE_ENV=development

# ==============================================================================
# Email Delivery (Development Outbox vs Production Amazon SES v2 in ap-south-1)
# ==============================================================================
# Development configuration (no domain or verified business email required):
EMAIL_DELIVERY_MODE=development
AWS_SES_ENABLED=false
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_NAME=Aurelia TimeFlow

# Optional in development (required in production):
# - APP_PUBLIC_URL: Optional in development; required in production (valid https:// URL).
# - AWS_SES_FROM_EMAIL: Optional when AWS_SES_ENABLED=false; required in production.
# APP_PUBLIC_URL=
# AWS_SES_FROM_EMAIL=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_SESSION_TOKEN=
# AWS_SES_CONFIGURATION_SET=

# Optional: Load SES credentials from AWS Secrets Manager JSON in production:
# AWS_SES_SECRET_JSON={"region":"ap-south-1","fromEmail":"<verified-ses-sender>","accessKeyId":"<key>","secretAccessKey":"<secret>","appPublicUrl":"<https-application-url>"}

# ==============================================================================
# AWS RDS PostgreSQL Configuration (Standard RDS Instance Endpoint in ap-south-1)
# ==============================================================================
AWS_REGION=ap-south-1
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=postgres
AWS_RDS_SSL_MODE=verify-full
AWS_RDS_POOL_MAX=10

# Private VPC & Backup Verification Gates (MUST remain false outside verified AWS VPC)
AWS_PRIVATE_VPC_EXECUTION=false
AWS_RDS_BACKUP_VERIFIED=false

# Set inside private AWS VPC runtime (ECS Fargate / App Runner / Secrets Manager):
# AWS_RDS_HOST=<db-instance-identifier>.<rds-dns-id>.ap-south-1.rds.amazonaws.com
# AWS_RDS_USER=<least-privilege-db-user>
# AWS_RDS_PASSWORD=<secrets-manager-or-env-password>
# AWS_RDS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AWS_RDS_SECRET_JSON={"host":"<db-instance>.<id>.ap-south-1.rds.amazonaws.com","port":5432,"dbname":"postgres","username":"<user>","password":"<secret>"}

# ==============================================================================
# Enterprise SSO / OIDC Configuration (Google Workspace / Microsoft Entra ID)
# ==============================================================================
# Optional: Load OIDC client credentials from AWS Secrets Manager JSON:
# AWS_SSO_SECRET_JSON={"clientId":"<oidc-client-id>","clientSecret":"<oidc-client-secret>","issuerUrl":"https://accounts.google.com","redirectUri":"<https-application-url>/api/v1/auth/oidc/google/callback","tenantId":"<tenant-uuid>"}



